{
  "release-type": "simple",
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "xml",
          "path": "Directory.Build.props",
          "xpath": "//Project/PropertyGroup/Version"
        }
      ]
    },
    "frontend": {
      "release-type": "node",
      "package-name": "frontend",
      "changelog-path": "frontend/CHANGELOG.md"
    }
  }
}
